# === Prisma (existing) ===
DATABASE_URL="postgres://USER:PASS@HOST:PORT/template1?sslmode=disable&connection_limit=10&connect_timeout=0"

# === Single-admin auth (required before production) ===
# Username the admin logs in with (defaults to "admin" if unset)
ADMIN_USERNAME="admin"
# scrypt-hashed password, format: <salt>:<64-byte-hex>. Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'YOUR_PASSWORD'
ADMIN_PASSWORD_HASH="replace-me"
# 64-char random secret signing the session cookie. Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET="replace-me"

# === AI provider ===
# The box runs a local model gateway (9Router, :20128). In Studio → AI Settings
# set one provider, baseURL http://<box-ip>:20128/v1, apiKey = the 9Router API key,
# model = one 9Router serves, e.g. kr/claude-sonnet-4.5 (do NOT leave model empty —
# empty falls back to a public-openai model 9Router cannot route and returns 404).