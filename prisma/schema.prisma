generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AiProviderConfig {
  id        String   @id @default(cuid())
  provider  String   @unique
  apiKey    String?
  baseURL   String?
  model     String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
