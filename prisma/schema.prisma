generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AiProviderConfig {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  apiKey    String?
  baseURL   String?
  model     String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, provider])
  @@index([userId])
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String
  role              Role              @default(USER)
  status            Status            @default(ACTIVE)
  accessType        AccessType        @default(DAYS_30)
  expiresAt         DateTime?
  lastActiveAt      DateTime?
  resetTokenHash    String?
  resetTokenExpires DateTime?
  createdById       String?
  createdBy         User?             @relation("UserCreations", fields: [createdById], references: [id], onDelete: SetNull)
  createdByMe       User[]            @relation("UserCreations")
  providerConfigs   AiProviderConfig[]
  activities        ActivityLog[]
  analyses          AnalysisLog[]
  geminiPoolId      String?
  geminiPool        GeminiKeyPool?    @relation("PoolUsers", fields: [geminiPoolId], references: [id], onDelete: SetNull)
  managedPools      GeminiKeyPool[]   @relation("PoolAdmin")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AnalysisLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  DISABLED
}

enum AccessType {
  DAYS_30
  UNLIMITED
  CUSTOM
}

model GeminiKeyPool {
  id        String      @id @default(cuid())
  name      String
  relayUrl  String?
  adminId   String?
  admin     User?       @relation("PoolAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  keys      GeminiKey[]
  users     User[]      @relation("PoolUsers")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model GeminiKey {
  id               String        @id @default(cuid())
  poolId           String
  pool             GeminiKeyPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  apiKey           String
  model            String
  isActive         Boolean       @default(true)
  cooldownUntil    DateTime?
  lastUsedAt       DateTime?
  consecutiveFails Int           @default(0)
  createdAt        DateTime      @default(now())

  @@index([poolId])
}
